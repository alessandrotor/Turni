# Copia in `.env.local` (gitignorato) e compila.
#
# NESSUNA CHIAVE API va qui dentro: tutto ciò che sta in un file .env viene
# sostituito da Vite dentro il bundle a build time, e il bundle finisce nell'APK
# in chiaro. La chiave Gemini vive solo sul proxy (vedi worker/README.md).

# URL del proxy AI. Senza, il pulsante "Importa turni da immagine" resta nascosto.
#   in locale:  http://localhost:8787   (npm run dev dentro worker/)
#   in rete:    https://turni-ai-proxy.<sottodominio>.workers.dev
VITE_AI_PROXY_URL=

# Raccoglitore della telemetria anonima (Google Apps Script). Vuoto = disattivata.
VITE_TELEMETRY_URL=

# Sitekey Turnstile (pubblica, non è un segreto: il segreto sta sul worker).
# Protegge l'import da abuso automatizzato. Vuota = verifica disattivata, utile
# in sviluppo. Nella dashboard Cloudflare il sitekey va creato in modalità
# INVISIBILE e deve elencare fra i domini ammessi anche `localhost`, altrimenti
# l'APK Capacitor — che gira su https://localhost — viene rifiutato.
VITE_TURNSTILE_SITEKEY=

# Riquadro con la ripartizione dei token dopo un import. Solo per sviluppo:
# lasciare vuoto o 'false' per qualunque build destinata allo Store.
VITE_DEBUG=

# Calcolo del netto (beta). Vuoto = acceso.
VITE_BETA_NET=

# Pagina Statistiche. Vuoto = SPENTA — al contrario del netto, perché è una
# pagina su cui non è ancora stata presa una decisione e il default deve essere
# quello che si vuole in produzione. Metti 'true' per averla in sviluppo.
VITE_BETA_STATS=
