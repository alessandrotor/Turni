# Copia questo file in `android/keystore.properties` (che è gitignorato) e
# compilalo con i dati del TUO keystore. Senza, la build di release non viene
# firmata e Play la rifiuta.
#
# Il keystore si crea una volta sola:
#
#   keytool -genkey -v -keystore turni-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias turni
#
# È la CHIAVE DI UPLOAD: quella di distribuzione la custodisce Google con Play
# App Signing. Perderla non è fatale (si chiede il reset), ma è una seccatura
# lunga: tieni il .jks fuori dal repository E fuori da questo computer.

storeFile=../turni-upload.jks
storePassword=CAMBIAMI
keyAlias=turni
keyPassword=CAMBIAMI
